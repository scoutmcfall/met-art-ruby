<div class="auth-container">
  <div class="auth-card">
    <h1>Create your free account</h1>
    <p class="muted">Join to save favorites, subscribe to updates, and curate your own collection.</p>

    <%= form_with model: @user, url: users_path, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :email_address, "Email", class: "form-label" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "Choose a strong password", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Create account", class: "btn btn-primary" %>
        <%= link_to "Already have an account? Sign in", new_session_path, class: "auth-link" %>
      </div>
    <% end %>
  </div>
</div>
