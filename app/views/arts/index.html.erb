<header class="site-header">
  <nav>
    <div class="brand">
      <h1>Arts</h1>
    </div>
      <div class="actions">
      <%= button_to "Login", new_session_path, class: "btn" unless authenticated? %>
      <%= button_to "Create account", new_user_path, class: "btn btn-primary" unless authenticated? %>
    </div>
  </nav>
</header>

<main>
  <section class="hero">
    <p class="lead">A curated listing of art — plus inspiring images from The Metropolitan Museum of Art.</p>
  </section>

  <section class="content-grid">
    <div class="arts-column">
      <h2>Your Arts</h2>
      <div class="arts-list">
        <% @arts.each do |art| %>
          <article class="card">
            <div class="card-body">
              <h3><%= link_to art.name, art_path(art.id) %></h3>
              <div class="meta">Added: <%= art.created_at.to_date %></div>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <aside class="met-column">
      <h2>From The Met</h2>
      <% if @external_images.present? %>
        <div class="met-grid">
          <% @external_images.each do |img| %>
            <div class="met-card">
                <div class="met-image">
                  <%= image_tag img[:src], alt: img[:title], loading: "lazy" %>
                </div>
                <div class="met-caption"><%= img[:title] %></div>
                <div class="met-details">
                  <% if img[:artist].present? %>
                    <div class="met-artist"><strong>Artist:</strong> <%= img[:artist] %></div>
                  <% end %>
                  <% if img[:date].present? %>
                    <div class="met-date"><strong>Date:</strong> <%= img[:date] %></div>
                  <% end %>
                  <% if img[:medium].present? %>
                    <div class="met-medium"><strong>Medium:</strong> <%= img[:medium] %></div>
                  <% end %>
                  <% if img[:department].present? %>
                    <div class="met-department"><strong>Department:</strong> <%= img[:department] %></div>
                  <% end %>
                  <% if img[:culture].present? %>
                    <div class="met-culture"><strong>Culture:</strong> <%= img[:culture] %></div>
                  <% end %>
                </div>
                <div class="met-actions" style="padding:0.5rem">
                  <% if authenticated? %>
                    <% subscribed = Current.user&.met_subscriptions&.exists?(met_object_id: img[:objectID]) %>
                    <% if subscribed %>
                      <%= button_to "Unsubscribe", met_unsubscribe_path(img[:objectID]), method: :delete, class: "btn" %>
                    <% else %>
                      <%= button_to "Subscribe", met_subscriptions_path(img[:objectID]), method: :post, class: "btn btn-primary" %>
                    <% end %>
                  <% else %>
                    <%= button_to "Login to subscribe", new_session_path, class: "btn" %>
                  <% end %>
                </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted">No external images available.</p>
      <% end %>
    </aside>
  </section>
</main>

