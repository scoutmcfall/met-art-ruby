<!-- Back link removed -->

<section class="art">
  <div class="art-media">
    <% if @art.featured_image.attached? %>
      <%= image_tag @art.featured_image, class: "art-featured" %>
    <% elsif @met_object && @met_object["primaryImage"].present? %>
      <%= image_tag @met_object["primaryImage"], class: "art-featured" %>
    <% end %>
  </div>

  <section class="art__info">
    <%= cache @art do %>
      <h1><%= @art.name %></h1>
      <div class="art-description"><%= @art.description %></div>
    <% end %>

    <% if @met_object.present? %>
      <div class="met-metadata">
        <% if @met_object["artistDisplayName"].present? %>
          <div><strong>Artist:</strong> <%= @met_object["artistDisplayName"] %></div>
        <% end %>
        <% if @met_object["objectDate"].present? %>
          <div><strong>Date:</strong> <%= @met_object["objectDate"] %></div>
        <% end %>
        <% if @met_object["medium"].present? %>
          <div><strong>Medium:</strong> <%= @met_object["medium"] %></div>
        <% end %>
        <% if @met_object["department"].present? %>
          <div><strong>Department:</strong> <%= @met_object["department"] %></div>
        <% end %>
        <% if @met_object["culture"].present? %>
          <div><strong>Culture:</strong> <%= @met_object["culture"] %></div>
        <% end %>
      </div>

      <!-- View on The Met button removed -->
    <% end %>

    <div class="art-actions">
      <% if authenticated? %>
        <%= link_to "Edit", edit_art_path(@art), class: "btn" %>
        <%= link_to "Delete", @art, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn" %>
      <% end %>
    </div>
  </section>
</section>

<!-- Modal is provided by the layout (single shared instance) -->
