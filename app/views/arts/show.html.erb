<p><%= link_to "Back", artss_path %></p>

<section class="art">
<%= image_tag @art.featured_image if @art.featured_image.attached? %>

<section class="art__info">
<%= cache @art do %>
<h1><%= @art.name %></h1>
  <%= @art.description %>
<% end %>
<%= render "inventory", art: @art %>

<%= link_to "Back", arts_path %>

<% if authenticated? %>
<%= link_to "Edit", edit_art_path(@art) %>
<%= button_to "Delete", @art, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
<% end %>
</section>
</section>